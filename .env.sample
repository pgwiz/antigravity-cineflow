# Video Workflow Studio Environment Configuration
# Copy this file to .env and set your credentials.

# Video Provider: "useapi" (Google Flow via useapi.net) or "genai" (Direct Google AI Studio)
VIDEO_PROVIDER=useapi

# useapi.net Google Flow API v1 (https://useapi.net/docs/api-google-flow-v1)
# Subscription API token from useapi.net
USEAPI_TOKEN=your_useapi_token_here
# Supported models: veo-3.1-fast, veo-3.1-quality, veo-3.1-lite, veo-3.1-lite-low-priority, omni-flash
USEAPI_MODEL=veo-3.1-fast
# Optional: specify connected Google Flow account email if multiple accounts configured
# USEAPI_ACCOUNT_EMAIL=your_dedicated_account@gmail.com

# Direct Google Gemini & Veo API Key (used when VIDEO_PROVIDER=genai or for Director Agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Video and Director Foundation Models
VIDEO_MODEL=veo-3.1-generate-preview
DIRECTOR_MODEL=gemini-3.5-flash-lite

# Optional: ElevenLabs API Key for voiceover narration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server Host & Port for REST API Bridge
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
