# Video Workflow Studio Environment Configuration
# Copy this file to .env and set your credentials.

# Google Gemini & Veo API Key (from Google AI Studio or Vertex AI)
GEMINI_API_KEY=your_gemini_api_key_here

# Video and Director Foundation Models
VIDEO_MODEL=veo-3.1-generate-preview
DIRECTOR_MODEL=gemini-3.5-flash-lite

# Optional: ElevenLabs API Key for voiceover narration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server Host & Port for REST API Bridge
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
