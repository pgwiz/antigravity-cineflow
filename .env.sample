# Video Workflow Studio Environment Configuration
# Copy this file to .env and set your credentials.

# Video Provider Options:
# "free"          : 100% Free AI Keyframe Generation (Pollinations.ai) + 2.5D Hollywood Motion (FFmpeg)
# "chrome"        : Option 1: Chrome Automation / CDP on flow.google.com/u/5/ (Google Flow Ultra)
# "flow_internal" : Option 2: Session Cookie / Labs API Client
# "useapi"        : Option 3: useapi.net Google Flow API v1 (Veo 3.1 & Omni Flash)
# "genai"         : Direct Google GenAI SDK (Veo 3.1 preview via Google AI Studio)
VIDEO_PROVIDER=free

# Option 1: Google Flow Chrome Automation
# Profile multi-user index: 5 corresponds to https://flow.google.com/u/5/
GOOGLE_FLOW_USER_INDEX=5
# Custom Chrome executable path (optional, auto-detected by default)
# CHROME_BINARY="C:\Program Files\Google\Chrome\Application\chrome.exe"
# CHROME_DEBUG_PORT=9222

# Option 2: Google Flow Session Cookie Client
# Exported session cookies (__Secure-1PSID, __Secure-3PSID, SAPISID)
# GOOGLE_FLOW_COOKIES="__Secure-1PSID=...; __Secure-3PSID=...;"

# Option 3: useapi.net Google Flow API v1 (https://useapi.net/docs/api-google-flow-v1)
# Subscription API token from useapi.net (keep intact for subscribers)
USEAPI_TOKEN=your_useapi_token_here
# Supported models: veo-3.1-fast, veo-3.1-quality, veo-3.1-lite, omni-flash
USEAPI_MODEL=veo-3.1-fast
# Optional: specify connected Google Flow account email if multiple accounts configured
# USEAPI_ACCOUNT_EMAIL=your_dedicated_account@gmail.com

# Direct Google Gemini & Veo API Key (used when VIDEO_PROVIDER=genai or for Director Agent)
GEMINI_API_KEY=your_gemini_api_key_here

# Video and Director Foundation Models
VIDEO_MODEL=veo-3.1-generate-preview
DIRECTOR_MODEL=gemini-3.5-flash-lite

# Optional: ElevenLabs API Key for voiceover narration
ELEVENLABS_API_KEY=your_elevenlabs_api_key_here

# Server Host & Port for REST API Bridge
SERVER_HOST=0.0.0.0
SERVER_PORT=8080
